# ---------------------------------------------------------------------------
# NUNCA versionar: segredos e dados locais
# ---------------------------------------------------------------------------

# Variáveis do docker compose (portas, PUID, ref) — local de cada máquina
.env

# Configuração da aplicação: contém OPENROUTER_API_KEY, NVIDIA_API_KEY,
# MODAL_TOKEN_*, EXA/PERPLEXITY/GEMINI keys, etc.
# O diretório é versionado (só o README), o conteúdo não.
config/*
!config/README.md

# Dados do usuário: projetos, sandboxes, sessões, ledger de custo e,
# principalmente, os tokens OAuth em data/kady/pi-agent/auth.json
# O diretório é versionado (só o README), o conteúdo não.
data/*
!data/README.md

# Qualquer .env solto, em qualquer nível
*.env
.env.*
!.env.example

# Credenciais avulsas
*auth.json
*credentials*.json
*.pem
*.key
*.p12
id_rsa*

# Local / editor
.claude/
.vscode/
.idea/
*.swp
.DS_Store

# Logs
*.log
