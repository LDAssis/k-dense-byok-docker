# ---------------------------------------------------------------------------
# Variáveis do DOCKER COMPOSE (não confundir com config/kady.env, que carrega
# as chaves de API da aplicação).
#
# Copie para .env:  make setup   (ou: cp .env.example .env)
# ---------------------------------------------------------------------------

## Versão do upstream (tag, branch ou commit de K-Dense-AI/k-dense-byok).
KADY_REF=v0.9.9
KADY_REPO=https://github.com/K-Dense-AI/k-dense-byok.git
# Mude para qualquer valor novo para forçar re-clone ignorando o cache de layer.
KADY_CACHEBUST=0

## Dono dos arquivos gravados em ./config e ./data.
## Use o seu: `id -u` e `id -g`.
PUID=1000
PGID=1000

## Endereço em que as portas são publicadas.
## ATENÇÃO: o Kady NÃO tem autenticação. Trocar para 0.0.0.0 expõe suas chaves
## de API e execução de shell arbitrária a toda a rede.
BIND_ADDR=127.0.0.1
KADY_UI_PORT=3000
KADY_API_PORT=8000

## URL da API vista pelo BROWSER. É embutida no bundle do Next durante o
## build — depois de alterar, rode `make build-web`.
## Acesso via LAN, por exemplo: http://192.168.0.10:8000
KADY_PUBLIC_API_URL=http://localhost:8000

## Ollama / LM Studio rodando no host.
OLLAMA_BASE_URL=http://host.docker.internal:11434

## Conteúdo da imagem do backend (0 desliga e reduz muito o tamanho).
INSTALL_TEXLIVE=1        # latexmk/pdflatex/synctex  (~2 GB)
INSTALL_SCI_HELPERS=1    # rdkit, gemmi, anndata, ... (~2 GB)
WARM_UV_CACHE=1          # numpy/pandas/matplotlib/scipy pré-baixados (~0,5 GB)

## Comportamento do entrypoint.
KADY_SKIP_PREP=0         # 1 = não roda o prep (projeto default + skills)
KADY_AUTO_UPDATE=0       # 1 = atualiza os pacotes Pi para @latest a cada boot
LOG_LEVEL=info
